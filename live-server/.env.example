# Copy to .env and replace every value. Never commit the real .env file.
GGDM_INGEST_USER=ggdm-publisher
# Use a long random alphanumeric password (at least 32 characters).
GGDM_INGEST_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

# Full RTMPS publish URLs, including each platform's stream key.
FACEBOOK_RTMP_URL=
YOUTUBE_RTMP_URL=
